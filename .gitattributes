# 仓库里的文本文件统一 LF：Windows 上不加这条，.sh 会被转成 CRLF，
# 到 Linux runner 上就报 "bad interpreter: /bin/bash^M" 之类。
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.config  text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制
*.png     binary
*.jpg     binary
*.gz      binary
*.img     binary
*.bin     binary

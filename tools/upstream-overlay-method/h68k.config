# =============================================================================
# HinLink H68K · ImmortalWrt 构建起点
#
# 用法：`cp configs/h68k.config <immortalwrt>/.config && make defconfig`
#
# 只在这里勾"编哪个机型"，功能包由机型定义（armv8.mk.hinlink 里的
# DEVICE_PACKAGES）负责 —— LuCI、全部无线网卡驱动、风扇/5G 支持都在那边，
# 不需要在这里重复列包，否则容易出现"这里加了、镜像阶段又缺依赖"。
# =============================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y

# ---- H68K 五个硬件变体 ----
#   a-b      2022 双千兆 2 口 + SATA      （板载 AP6256，WAN=eth0）
#   a-b-usb  同上，SATA 换成 USB3.0        （RK3568 sata0/USB3 争同一颗 combphy）
#   c-d-f    2022~2023.4 四网口 2×2.5G + SATA
#   c-d-f-usb 同上，SATA 换成 USB3.0
#   new      2023 末~2024，板载 AIC8800，SATA 与 USB3 可同时用（WAN=eth1）
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-a-b=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-a-b-usb=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-c-d-f=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-c-d-f-usb=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-new=y

# ---- 分区大小 ----
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---- 编译加速 ----
CONFIG_CCACHE=y

# ---- 镜像格式：squashfs sysupgrade（默认）+ ext4 备用 ----
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# ---- 关掉调试符号，省磁盘 ----
# CONFIG_DEVEL is not set
# CONFIG_DEBUG is not set

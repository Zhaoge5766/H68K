# =====================================================================
# H68K 编译种子配置
#
# 这不是一份"完整 .config" —— 只把**目标平台**钉住，其余交给
# `make defconfig` 按官方默认值展开。
#
# 为什么不在这里写机型 / 包列表：
#   · 机型由 diy-part2.sh 按 $DEVICES 逐个打开。写在这里的话，改动
#     $DEVICES 时旧机型的 =y 会残留（下面附了注释块，要手写就照那个格式）
#   · 机型带哪些包（LuCI、各型号无线网卡驱动、风扇、OLED）写在适配层的
#     image/armv8.mk.hinlink 的 DEVICE_PACKAGES 里，device 定义是唯一来源；
#     这里再抄一遍必然漂移
#   · 额外插件由 diy-part2.sh 按 $PLUGINS 打开（passwall2 / nikki /
#     openclash / diskman）
# =====================================================================

# ---- 目标平台 ----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y

# ---- 允许多机型一次编译（DEVICES 里给多个名字时靠它）----
CONFIG_TARGET_MULTI_PROFILE=y

# ---- 机型：由 diy-part2.sh 写入，全系时是这五行 ----
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-a-b=y
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-a-b-usb=y
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-c-d-f=y
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-c-d-f-usb=y
# CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-new=y

# ---- u-boot 变体 ----
#   5 个机型共用 hinlink-h68k-rk3568 这一个变体（同一块板子的不同板本）。
#   正常情况下 make defconfig 会因为它出现在 BUILD_DEVICES 里而自动选上，
#   这里显式写一遍：defconfig 行为一变就直接暴露，而不是等到镜像阶段
#   报 "No such file: .../hinlink-h68k-rk3568-u-boot-rockchip.bin"。
CONFIG_PACKAGE_u-boot-hinlink-h68k-rk3568=y

# ---- 编译缓存 ----
CONFIG_CCACHE=y

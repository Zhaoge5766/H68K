# =====================================================================
# H68K 编译种子配置
#
# 这不是一份"完整 .config" —— 只是把**目标和机型**钉住，其余交给
# `make defconfig` 按官方默认值展开。
#
# 这样做的原因：机型带哪些包（LuCI、各型号无线网卡驱动、5G 模组支持、
# 风扇、OLED）全写在该机型的 DEVICE_PACKAGES 里（适配层的
# image/armv8.mk.hinlink），device 定义是唯一来源。种子配置只管
# "编哪个板子"，不重复抄包列表 —— 抄了就会和适配层漂移。
#
# 要加自己的包，写进 diy-part2.sh，别改这里。
# =====================================================================

# ---- 目标平台 ----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y

# ---- 允许多机型一次编译（DEVICES 里给多个名字时靠它）----
CONFIG_TARGET_MULTI_PROFILE=y

# ---- 默认机型（diy-part2.sh 会按 DEVICES 变量补上其余的）----
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_hinlink_opc-h68k-new=y

# ---- u-boot 变体 ----
#   正常情况下 make defconfig 会因为它出现在 BUILD_DEVICES 里而自动选上，
#   这里显式写一遍：defconfig 行为一变就直接暴露，而不是等到镜像阶段
#   报 "No such file: .../hinlink-h68k-rk3568-u-boot-rockchip.bin"。
CONFIG_PACKAGE_u-boot-hinlink-h68k-rk3568=y

# ---- 编译缓存 ----
CONFIG_CCACHE=y
